<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Required on API 29+ for TYPE_STEP_DETECTOR. Debug-only until a release feature needs it (step detection uses the
       app's own accelerometer detector), so release does not declare an unused dangerous permission. -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

  <application>
    <activity
      android:name=".HiltTestActivity"
      android:exported="false" />
    <!-- Debug-only sensor trace recorder; second launcher entry so it can be started while walking. -->
    <activity
      android:name=".trace.TraceRecorderActivity"
      android:exported="true"
      android:label="@string/trace_launcher_label"
      android:screenOrientation="portrait"
      android:taskAffinity=".trace">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
